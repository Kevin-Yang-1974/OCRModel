#!/usr/bin/env bash
# Copy this file to config/paths.env on each machine. Keep paths.env untracked.
# All defaults are derived from the repository location and can be overridden
# before sourcing this file.

_ocrmodel_config_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
_ocrmodel_default_root="$(cd -- "${_ocrmodel_config_dir}/.." && pwd -P)"

export OCRMODEL_ROOT="${OCRMODEL_ROOT:-${_ocrmodel_default_root}}"
export OCR_WORKSPACE="${OCR_WORKSPACE:-$(cd -- "${OCRMODEL_ROOT}/.." && pwd -P)}"
export GOT_PROJECT_ROOT="${GOT_PROJECT_ROOT:-${OCRMODEL_ROOT}/src/GOT-OCR-2.0}"

# Model and dataset assets live outside the repository.
export GOT_SOURCE_MODEL="${GOT_SOURCE_MODEL:-${OCR_WORKSPACE}/models/GOT-OCR2_0}"
export ANANDASKY_MODEL="${ANANDASKY_MODEL:-${OCR_WORKSPACE}/models/AnandaSky}"
export ANCIENTDOC_ROOT="${ANCIENTDOC_ROOT:-${OCR_WORKSPACE}/datasets/AncientDoc}"

# Writable data and experiment roots.
export GOT_LINELEVEL_DATA="${GOT_LINELEVEL_DATA:-${OCR_WORKSPACE}/datasets/got_linelevel}"
export GOT_LAYOUT_DATA="${GOT_LAYOUT_DATA:-${OCR_WORKSPACE}/datasets/got_layout_pages}"
export ANCIENTDOC_AUDIT="${ANCIENTDOC_AUDIT:-${OCR_WORKSPACE}/audits/ancientdoc/audit.json}"
export GOT_TRAINING_RUNS="${GOT_TRAINING_RUNS:-${OCR_WORKSPACE}/runs/training/GOT}"
export GOT_EVALUATION_RUNS="${GOT_EVALUATION_RUNS:-${OCR_WORKSPACE}/runs/evaluation/GOT}"

# Optional launcher defaults. Explicit CLI flags take precedence.
export GOT_PHYSICAL_GPU="${GOT_PHYSICAL_GPU:-0}"
export GOT_VALIDATION_GPU_IDS="${GOT_VALIDATION_GPU_IDS:-0}"

# Runtime caches also stay outside the repository. Set HF_ENDPOINT explicitly
# in the machine-local file only when a mirror is required.
export HF_HOME="${HF_HOME:-${OCR_WORKSPACE}/cache/huggingface}"

unset _ocrmodel_config_dir _ocrmodel_default_root
